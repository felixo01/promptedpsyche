---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publications } from '../../lib/publications';

const alternateLinks = {
  en: '/publications/',
  pl: '/pl/publications/',
  xDefault: '/publications/'
};

function formatPublicationDate(value: string) {
  return new Intl.DateTimeFormat('pl-PL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC'
  }).format(new Date(`${value}T00:00:00Z`));
}
---

<BaseLayout
  lang="pl"
  title="Publikacje"
  description="Kanoniczne strony Prompted Psyche, rekordy DOI, pliki PDF i rekordy Zenodo publikacji Feliksa Mamczura."
  alternateLinks={alternateLinks}
  robots="index, follow"
>
  <article class="lovable-page projects-page publications-page">
    <header class="lovable-page-hero projects-hero">
      <div class="lovable-container projects-hero__inner">
        <div>
          <p class="eyebrow">Dorobek badawczy</p>
          <h1>Publikacje</h1>
          <p class="lede">
            Sześć publikacji Feliksa Mamczura ze stałymi rekordami DOI i zdeponowanymi plikami PDF.
          </p>
          <p class="hero-subnote">
            Ta strona jest polskim przeglądem. Każdy wpis prowadzi do kanonicznej angielskiej
            strony publikacji i odpowiadającego jej rekordu Zenodo. DOI identyfikuje wersję
            publikacji; nie oznacza recenzji naukowej.
          </p>
        </div>
      </div>
    </header>

    <section class="lovable-section" aria-labelledby="publication-list-title">
      <div class="lovable-container">
        <div class="lovable-section-header projects-section__header">
          <div>
            <p class="section-kicker">Publikacje</p>
            <h2 id="publication-list-title">Rekordy kanoniczne</h2>
          </div>
          <p>Tytuły, daty i identyfikatory są zgodne ze zdeponowanymi rekordami Zenodo.</p>
        </div>

        <div class="projects-grid publications-grid" data-qa="publication-list">
          {publications.map((publication) => (
            <article class="project-card publication-card" data-doi={publication.doi}>
              <p class="project-card__status">{publication.publicationType}</p>
              <h3 lang="en">{publication.title}</h3>
              <dl class="project-card__details publication-card__details">
                <div>
                  <dt>Opublikowano</dt>
                  <dd>
                    <time datetime={publication.publicationDate}>
                      {formatPublicationDate(publication.publicationDate)}
                    </time>
                  </dd>
                </div>
                {'version' in publication && publication.version && (
                  <div><dt>Wersja</dt><dd>{publication.version}</dd></div>
                )}
                <div><dt>Status</dt><dd>{publication.status}</dd></div>
                <div><dt>Licencja</dt><dd><a href={publication.license.url}>{publication.license.name}</a></dd></div>
                <div><dt>DOI</dt><dd><a href={publication.doiUrl}>{publication.doi}</a></dd></div>
              </dl>
              <nav class="publication-card__links" aria-label={`Linki do publikacji ${publication.title}`}>
                <a class="text-link" href={publication.landingPath}>Strona kanoniczna</a>
                <a class="text-link" href={publication.pdf.url}>PDF</a>
                <a class="text-link" href={publication.zenodoRecordUrl}>Zenodo</a>
              </nav>
            </article>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .publications-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .publication-card h3,
  .publication-card__details dd {
    overflow-wrap: anywhere;
  }

  .publication-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1rem;
  }

  @media (max-width: 760px) {
    .publications-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
