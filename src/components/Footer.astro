---
import { getLangFromPath, type Locale } from '../lib/i18n';
import { site } from '../lib/site';
import BrandMark from './BrandMark.astro';
import RightsNotice from './RightsNotice.astro';

interface Props {
  lang?: Locale;
}

const activeLang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const isPl = activeLang === 'pl';
const prefix = isPl ? '/pl' : '';
---

<footer class="site-footer" data-qa="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-intro">
        <BrandMark href={`${prefix}/`} line={isPl ? 'Autorski magazyn idei o człowieku i AI.' : 'An independent magazine of ideas about people and AI.'} />
        <p class="c2-footer-note">{isPl ? 'Myślenie, zaufanie, twórczość. Pytania, przy których warto się zatrzymać.' : 'Thinking, trust, creativity. Questions worth spending time with.'}</p>
        <div class="footer-author">
          <div>
            <p>Feliks Mamczur</p>
            <a href="https://orcid.org/0009-0001-0715-0517" rel="me noopener">
              ORCID · 0009-0001-0715-0517
            </a>
          </div>
        </div>
      </div>

      <div class="footer-inquiries">
        <div>
          <h3>{isPl ? 'Zapytania' : 'Inquiries'}</h3>
          <ul>
            <li><a href={`${prefix}/consulting/`} data-qa="consulting-nav-link" class="site-nav__consulting">{isPl ? 'Konsulting dla organizacji' : 'Organizational consulting'}</a></li>
            <li><a href={`${prefix}/consulting/`}>{isPl ? 'Warsztaty i wystąpienia' : 'Workshops and talks'}</a></li>
            <li><a href={`${prefix}/contact/`}>{isPl ? 'Komentarz medialny' : 'Media commentary'}</a></li>
            <li><a href={`${prefix}/contact/`}>{isPl ? 'Rozmowy badawcze' : 'Research conversations'}</a></li>
          </ul>
        </div>
        <div>
          <h3>{isPl ? 'Kontakt' : 'Contact'}</h3>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>

    <div class="footer-rights">
      <RightsNotice lang={activeLang} variant="footer" />
    </div>

    <div class="footer-utility">
      <div class="footer-bottom__meta">
        <div class="footer-bottom__identity">
          <p>Prompted Psyche</p>
        </div>
        <p class="footer-version" data-qa="site-version">
          {isPl ? 'Wersja strony' : 'Site version'}: {site.version}
        </p>
      </div>
      <nav aria-label={isPl ? 'Linki w stopce' : 'Footer links'}>
        <a href={`${prefix}/publications/`}>{isPl ? 'Publikacje' : 'Publications'}</a>
        <a href={`${prefix}/notes/`}>{isPl ? 'Notatki' : 'Notes'}</a>
        <a href={`${prefix}/search/`}>{isPl ? 'Szukaj' : 'Search'}</a>
        <a href={`${prefix}/topics/`}>{isPl ? 'Obszary' : 'Topics'}</a>
        <a href={`${prefix}/concepts/`}>{isPl ? 'Pojęcia' : 'Concepts'}</a>
        <a href={`${prefix}/about/`}>{isPl ? 'Kim jestem' : 'Author'}</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
  </div>
</footer>
