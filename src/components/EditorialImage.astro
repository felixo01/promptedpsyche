---
import { Image } from 'astro:assets';
import type { Locale } from '../lib/i18n';
import trustImage from '../assets/editorial/c2-trust-hidden-sources.png';
import authorshipImage from '../assets/editorial/c2-authorship-final-decision.png';
import learningImage from '../assets/editorial/c2-learning-active-reasoning.png';
interface Props { kind: 'trust' | 'authorship' | 'learning'; lang: Locale; priority?: boolean; wide?: boolean; }
const { kind, lang, priority = false, wide = false } = Astro.props;
const source = { trust: trustImage, authorship: authorshipImage, learning: learningImage }[kind];
const alt = {
  trust: { pl: 'Ilustracja: spod uporządkowanej odpowiedzi wyłaniają się warstwy źródeł i prowadząca do nich nić.', en: 'Illustration: layers of sources and a thread tracing their origin emerge beneath a tidy answer.' },
  authorship: { pl: 'Ilustracja: ludzka ręka redaguje i wybiera ostateczną wersję spośród kilku propozycji.', en: 'Illustration: a human hand edits and selects the final version from several alternatives.' },
  learning: { pl: 'Ilustracja: gotowe rozwiązanie obok dłoni samodzielnie składającej elementy układanki.', en: 'Illustration: a completed solution beside a hand working through the puzzle independently.' }
}[kind][lang];
const sizes = wide ? '(max-width: 1128px) calc(100vw - 40px), 1088px' : '(max-width: 1000px) calc(100vw - 40px), (max-width: 1256px) calc((100vw - 80px) / 2), 588px';
---
<Image src={source} alt={alt} width={source.width} widths={[400, 800, 1200, 1536]} format="webp" quality={82}
  sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
